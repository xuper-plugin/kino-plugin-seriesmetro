{
  "id": "seriesmetro",
  "name": "SeriesMetro",
  "version": "1.3.4",
  "apiVersion": 30,
  "entry": "plugin.js",
  "icon": "icon.png",
  "description": "Películas y series en latino, castellano o subtituladas, a través de SeriesMetro.",
  "author": "xuper-plugin",
  "homepage": "https://github.com/xuper-plugin/kino-plugin-seriesmetro",
  "hosts": [
    "www3.seriesmetro.net",
    "fastream.to"
  ],
  "fetchHosts": "any",
  "streamHosts": "any",
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve",
    "download",
    "screen"
  ],
  "categories": [
    "movies",
    "series"
  ],
  "color": "#00ACC1",
  "theme": {
    "accent": "#29C5EE",
    "onAccent": "#06141A",
    "background": "#070E10",
    "surface": "#10202A",
    "highlight": "#80DEEA"
  },
  "telemetry": true,
  "settings": [
    {
      "key": "language",
      "label": "Idioma preferido",
      "labelEn": "Preferred language",
      "type": "select",
      "default": "lat",
      "options": [
        {
          "value": "lat",
          "label": "Latino",
          "labelEn": "Latin American"
        },
        {
          "value": "esp",
          "label": "Castellano",
          "labelEn": "Castilian"
        },
        {
          "value": "sub",
          "label": "Subtitulado",
          "labelEn": "Subtitled"
        }
      ]
    },
    {
      "key": "cacheSection",
      "label": "Caché",
      "labelEn": "Cache",
      "type": "section",
      "hint": "Los nombres y años de cada título se guardan 7 días.",
      "hintEn": "Each title's names and years are kept for 7 days."
    },
    {
      "key": "clearCache",
      "label": "Vaciar caché",
      "labelEn": "Clear cache",
      "type": "action",
      "confirm": "¿Vaciar la caché de títulos?",
      "confirmEn": "Clear the title cache?"
    }
  ],
  "recommends": [
    "xuper-plugin/kino-plugin-kino-resolver"
  ],
  "browser": true,
  "screen": {
    "label": "SeriesMetro",
    "labelEn": "SeriesMetro",
    "icon": "movie",
    "menuOpens": "screen",
    "opensFrom": [
      "menu",
      "settings"
    ],
    "settingsButton": {
      "label": "Abrir SeriesMetro",
      "labelEn": "Open SeriesMetro"
    },
    "settingsIn": "both"
  },
  "consumes": {
    "resolver": {
      "repo": "xuper-plugin/kino-plugin-kino-resolver",
      "door": "resolver",
      "calls": [
        "resolve"
      ]
    }
  },
  "provides": {
    "catalog": {
      "summary": "Titles this plugin finds, for the author's other plugins",
      "calls": {
        "search": {
          "in": {
            "q": "string",
            "type": "string?"
          },
          "out": "Item[]"
        }
      },
      "types": {
        "Item": {
          "id": "string",
          "ref": "string",
          "title": "string",
          "kind": "string",
          "poster": "string?",
          "backdrop": "string?",
          "year": "string?",
          "overview": "string?",
          "tmdb": "number?"
        }
      }
    }
  },
  "signature": {
    "authorKey": "6693946bd5c56196960959c4b9665fad5094374bcb85ddb282f8bf762c835263",
    "value": "ef7548388666d7af8ae147af9769aa80337311bb1d53aa61f447e964fdd257d4813bb2295d87611f39b547287a2de55308bfc6f506693fe0c7ec2c70def24a04"
  }
}
